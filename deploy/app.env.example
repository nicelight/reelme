# Docker env_file format: raw. Values are literal; do not add shell quotes.
# Set both initial passwords (12–256 characters), run setup, then clear them.
ADMIN_PASSWORD=
OPERATOR_PASSWORD=
FAL_KEY=
# Optional BILLING key for /statuses. Leave empty to use FAL_KEY (FULL).
FAL_BILLING_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
