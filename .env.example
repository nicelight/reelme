# No secrets use the VITE_ prefix. Origin must match the browser URL exactly.
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Persistent data, independent of dist/ (absolute path recommended on VPS).
DATA_DIR=./var
# Used only by npm run setup for initial accounts; remove after setup.
ADMIN_PASSWORD=
OPERATOR_PASSWORD=

# Server-only fal key; requires a publicly reachable HTTPS APP_ORIGIN.
# Empty keeps generation pending during capture-only local development.
FAL_KEY=

# SMTP.BZ settings from its dashboard; verified sender, server-only credentials.
# All empty disables email worker and keeps accepted forms pending locally.
# Port 465 uses implicit TLS; other ports require STARTTLS (usually 587).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
